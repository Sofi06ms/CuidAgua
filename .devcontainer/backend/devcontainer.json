{
  "name": "CuidAgua - Backend (Java 21 + Spring Boot)",
  "dockerComposeFile": ["../../backend/docker-compose.dev.yml"],
  "service": "app",
  "runServices": ["app", "db", "keycloak"],
  "workspaceFolder": "/workspace/backend",
  "shutdownAction": "stopCompose",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "forwardPorts": [8080, 8180, 5432],
  "portsAttributes": {
    "8080": { "label": "API CuidAgua" },
    "8180": { "label": "Keycloak" },
    "5432": { "label": "PostgreSQL" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "rangav.vscode-thunder-client"
      ]
    }
  },

  "remoteUser": "vscode"
}
