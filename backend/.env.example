# Variables opcionales para backend/docker-compose.yml.
# Copia este archivo como .env (en la carpeta backend). El archivo .env no se sube al repositorio.

# IP de esta computadora en la red local (Windows: ipconfig -> "Dirección IPv4").
# Necesaria solo para conectar la app desde un celular. Ejemplo: 192.168.1.50
IP_LAN=

# Contraseña de PostgreSQL (por defecto: cuidagua). Solo para desarrollo.
# POSTGRES_PASSWORD=cuidagua
