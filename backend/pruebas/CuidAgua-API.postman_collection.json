{
  "info": {
    "name": "CuidAgua API",
    "description": "Pruebas de la API de CuidAgua: reportes (registro, filtros, cambio de estado, resumen) y avisos (CRUD y filtros). Ejecutar en orden: primero se obtienen los tokens de Keycloak y se guardan en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8180"
    },
    {
      "key": "tokenCiudadano",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "fechaFutura",
      "value": ""
    },
    {
      "key": "reporteId",
      "value": ""
    },
    {
      "key": "avisoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Salud de la API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API responde 200 y está UP', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener token de ciudadano1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak entrega el token (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('tokenCiudadano', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "cuidagua-app"
                },
                {
                  "key": "username",
                  "value": "ciudadano1"
                },
                {
                  "key": "password",
                  "value": "ciudadano123"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/cuidagua/protocol/openid-connect/token"
          }
        },
        {
          "name": "Obtener token de admin1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak entrega el token (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "cuidagua-app"
                },
                {
                  "key": "username",
                  "value": "admin1"
                },
                {
                  "key": "password",
                  "value": "admin123"
                }
              ]
            },
            "url": "{{keycloakUrl}}/realms/cuidagua/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "2. Reportes",
      "item": [
        {
          "name": "Crear reporte válido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 con el reporte en PENDIENTE', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.exito).to.eql(true);",
                  "  pm.expect(json.datos.estado).to.eql('PENDIENTE');",
                  "  pm.expect(json.datos.usuario).to.eql('ciudadano1');",
                  "});",
                  "pm.collectionVariables.set('reporteId', pm.response.json().datos.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCiudadano}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"FUGA\",\n  \"descripcion\": \"Fuga de agua en la banqueta frente al número 25\",\n  \"direccion\": \"Av. Juárez 25\",\n  \"colonia\": \"Centro\",\n  \"zona\": \"Zona Centro\",\n  \"latitud\": 19.4326,\n  \"longitud\": -99.1332,\n  \"fotoUrl\": \"https://ejemplo.com/fotos/fuga1.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/reportes"
          }
        },
