    {
      "name": "2. Zonas",
      "item": [
        {
          "name": "Listar zonas (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve el catálogo de zonas', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const zonas = pm.response.json().datos;",
                  "  pm.expect(zonas.length).to.be.at.least(3);",
                  "  pm.expect(zonas[0]).to.have.property('id');",
                  "  pm.expect(zonas[0]).to.have.property('nombre');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/zonas"
          }
        }
      ]
