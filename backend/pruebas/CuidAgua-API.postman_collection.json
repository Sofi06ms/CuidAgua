    {
      "name": "3. Reportes",
      "item": [
        {
          "name": "Crear reporte válido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 con folio, estado pendiente y evidencias', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const d = pm.response.json().datos;",
                  "  pm.expect(d.folio).to.match(/^CA-\\d{4}-\\d{6}$/);",
                  "  pm.expect(d.estado).to.eql('pendiente');",
                  "  pm.expect(d.categoria).to.eql('fuga');",
                  "  pm.expect(d.zona.id).to.eql(2);",
                  "  pm.expect(d.evidencias.length).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set('reporteId', pm.response.json().datos.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCiudadano}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoria\": \"fuga\",\n  \"descripcion\": \"Fuga de agua en la banqueta frente al número 25\",\n  \"zonaId\": 2,\n  \"latitud\": 20.1765,\n  \"longitud\": -98.0535,\n  \"evidencias\": [\n    \"https://ejemplo.com/fotos/fuga1.jpg\"\n  ]\n}"
