{
  "info": {
    "name": "CuidAgua API",
    "description": "Pruebas de la API de CuidAgua: zonas, reportes (registro con folio y evidencias, filtros por estado/categoría/zona, cambio de estado con historial, resumen) y avisos (CRUD y filtros). Ejecutar en orden: primero se obtienen los tokens de Keycloak (ciudadano1, personal1, admin1) y se guardan en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Salud de la API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API responde 200 y está UP', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      }
    },
