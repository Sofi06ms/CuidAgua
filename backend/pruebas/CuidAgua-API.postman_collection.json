              "mode": "raw",
              "raw": "{\n  \"tipo\": \"SIN_AGUA\",\n  \"descripcion\": \"No hay agua desde ayer en toda la calle\",\n  \"direccion\": \"Calle 5 de Mayo 10\",\n  \"colonia\": \"Centro\",\n  \"zona\": \"Zona Centro\"\n}"
            },
