                  "  const d = pm.response.json().datos;",
                  "  pm.expect(d.tipo).to.eql('corte');",
                  "  pm.expect(d.zona.id).to.eql(2);",
                  "  pm.expect(d.vigente).to.eql(true);",
                  "  pm.expect(d.creadoPor).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('avisoId', pm.response.json().datos.id);"
                ]
              }
            }
