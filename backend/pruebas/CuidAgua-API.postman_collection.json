{
  "info": {
    "name": "CuidAgua API",
    "description": "Pruebas de los endpoints iniciales de la API de CuidAgua. Ejecutar en orden: primero se obtienen los tokens de Keycloak y se guardan en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8180" },
    { "key": "tokenCiudadano", "value": "" },
    { "key": "tokenAdmin", "value": "" },
    { "key": "fechaFutura", "value": "" }
  ],
  "item": [
    {
      "name": "0. Salud de la API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La API responde 200 y está UP', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener token de ciudadano1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak entrega el token (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('tokenCiudadano', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "cuidagua-app" },
                { "key": "username", "value": "ciudadano1" },
                { "key": "password", "value": "ciudadano123" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/cuidagua/protocol/openid-connect/token"
          }
        },
        {
          "name": "Obtener token de admin1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak entrega el token (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('tokenAdmin', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "cuidagua-app" },
                { "key": "username", "value": "admin1" },
                { "key": "password", "value": "admin123" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/cuidagua/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "2. Reportes",
      "item": [
        {
          "name": "Crear reporte válido (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 con el reporte en PENDIENTE', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.exito).to.eql(true);",
                  "  pm.expect(json.datos.estado).to.eql('PENDIENTE');",
                  "  pm.expect(json.datos.usuario).to.eql('ciudadano1');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCiudadano}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"FUGA\",\n  \"descripcion\": \"Fuga de agua en la banqueta frente al número 25\",\n  \"direccion\": \"Av. Juárez 25\",\n  \"colonia\": \"Centro\",\n  \"latitud\": 19.4326,\n  \"longitud\": -99.1332,\n  \"fotoUrl\": \"https://ejemplo.com/fotos/fuga1.jpg\"\n}"
            },
            "url": "{{baseUrl}}/api/reportes"
          }
        },
        {
          "name": "Crear reporte inválido (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 con errores por campo', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.exito).to.eql(false);",
                  "  pm.expect(json.errores).to.have.property('tipo');",
                  "  pm.expect(json.errores).to.have.property('descripcion');",
                  "  pm.expect(json.errores).to.have.property('latitud');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCiudadano}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Corta\",\n  \"direccion\": \"\",\n  \"colonia\": \"Centro\",\n  \"latitud\": 120\n}"
            },
            "url": "{{baseUrl}}/api/reportes"
          }
        },
        {
          "name": "Crear reporte sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().exito).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"SIN_AGUA\",\n  \"descripcion\": \"No hay agua desde ayer en toda la calle\",\n  \"direccion\": \"Calle 5 de Mayo 10\",\n  \"colonia\": \"Centro\"\n}"
            },
            "url": "{{baseUrl}}/api/reportes"
          }
        },
        {
          "name": "Listar reportes (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 con una lista', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().datos).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/reportes"
          }
        },
        {
          "name": "Listar reportes por colonia (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Todos los reportes son de la colonia Centro', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().datos.forEach(r => pm.expect(r.colonia.toLowerCase()).to.eql('centro'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reportes?colonia=Centro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reportes"],
              "query": [{ "key": "colonia", "value": "Centro" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Avisos",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fecha 3 días en el futuro con formato yyyy-MM-ddTHH:mm:ss",
              "const futura = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString().slice(0, 19);",
              "pm.collectionVariables.set('fechaFutura', futura);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Crear aviso como admin (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 y guarda quién lo creó', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.exito).to.eql(true);",
                  "  pm.expect(json.datos.creadoPor).to.eql('admin1');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Corte programado de agua\",\n  \"mensaje\": \"Se suspenderá el servicio por mantenimiento de la red principal.\",\n  \"colonia\": \"Centro\",\n  \"tipo\": \"CORTE\",\n  \"fechaRestablecimiento\": \"{{fechaFutura}}\"\n}"
            },
            "url": "{{baseUrl}}/api/avisos"
          }
        },
        {
          "name": "Crear aviso como ciudadano (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 403 porque no tiene rol ADMIN', function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().exito).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCiudadano}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Aviso no autorizado\",\n  \"mensaje\": \"Un ciudadano no debería poder publicar este aviso.\",\n  \"colonia\": \"Centro\",\n  \"tipo\": \"CORTE\",\n  \"fechaRestablecimiento\": \"{{fechaFutura}}\"\n}"
            },
            "url": "{{baseUrl}}/api/avisos"
          }
        },
        {
          "name": "Crear aviso con fecha pasada (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400 por fechaRestablecimiento en el pasado', function () {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().errores).to.have.property('fechaRestablecimiento');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenAdmin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Restablecimiento atrasado\",\n  \"mensaje\": \"Este aviso tiene una fecha de restablecimiento en el pasado.\",\n  \"colonia\": \"Centro\",\n  \"tipo\": \"RESTABLECIMIENTO\",\n  \"fechaRestablecimiento\": \"2020-01-01T08:00:00\"\n}"
            },
            "url": "{{baseUrl}}/api/avisos"
          }
        },
        {
          "name": "Listar avisos (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 con una lista', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().datos).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/avisos"
          }
        },
        {
          "name": "Listar avisos por colonia (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200 con avisos de Centro', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.response.json().datos.forEach(a => pm.expect(a.colonia.toLowerCase()).to.eql('centro'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/avisos?colonia=Centro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "avisos"],
              "query": [{ "key": "colonia", "value": "Centro" }]
            }
          }
        }
      ]
    }
  ]
}
