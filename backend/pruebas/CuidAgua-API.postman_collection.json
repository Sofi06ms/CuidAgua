                  "  const json = pm.response.json();",
                  "  pm.expect(json.exito).to.eql(false);",
                  "  pm.expect(json.errores).to.have.property('tipo');",
                  "  pm.expect(json.errores).to.have.property('descripcion');",
                  "  pm.expect(json.errores).to.have.property('latitud');",
                  "  pm.expect(pm.response.json().errores).to.have.property('zona');",
