    {
      "name": "4. Avisos",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Fecha 3 días en el futuro con formato yyyy-MM-ddTHH:mm:ss",
              "const futura = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString().slice(0, 19);",
              "pm.collectionVariables.set('fechaFutura', futura);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Crear aviso como admin (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
